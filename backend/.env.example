# Configuracion del backend (estructura app/)
# Copia este archivo como .env y ajusta los valores

# Base de datos PostgreSQL
# Base de datos PostgreSQL (entorno local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin_user
DB_PASSWORD=admin_password
DB_NAME=inventario_db

# Seguridad
SECRET_KEY=cambiar_esta_clave_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Usuario administrador por defecto (se crea al iniciar)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@zoom.com
DEFAULT_ADMIN_PASSWORD=Admin12345

# Deteccion YOLO
YOLO_MODEL_PATH=app/models/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
# Mapeo de clases YOLO a productos (JSON), opcional:
# YOLO_CLASS_MAP={"0":1,"1":2}

# CORS
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Depuracion
DEBUG=True