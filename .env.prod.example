# Configuracion de produccion (laptop del salon)
# Copia este archivo como .env.prod y cambia la SECRET_KEY

# Credenciales de la base de datos
DB_USER=zoom_user
DB_PASSWORD=cambia_esta_password

# Clave secreta para firmar JWT (genera una con: openssl rand -hex 32)
SECRET_KEY=cambia_esta_clave_por_una_segura_y_larga

# Usuario administrador inicial
DEFAULT_ADMIN_EMAIL=admin@zoom.com
DEFAULT_ADMIN_PASSWORD=Admin12345